{
  "redirects": [
    { "source": "/embed/about",     "destination": "/about",     "permanent": true },
    { "source": "/embed/rates",     "destination": "/rates",     "permanent": true },
    { "source": "/embed/meds",      "destination": "/meds",      "permanent": true },
    { "source": "/embed/providers", "destination": "/providers", "permanent": true },
    { "source": "/embed/health",    "destination": "/health",    "permanent": true },
    { "source": "/embed/results",   "destination": "/results",   "permanent": true },
    { "source": "/embed/apply",     "destination": "/apply",     "permanent": true },
    { "source": "/embed/submitted", "destination": "/submitted", "permanent": true },
    { "source": "/embed",           "destination": "/about",     "permanent": true },
    { "source": "/embed/",          "destination": "/about",     "permanent": true }
  ],
  "rewrites": [
    { "source": "/:path((?!api|assets).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(self), microphone=(self), geolocation=()" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'self' https://generationhealth.me https://*.generationhealth.me" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ]
}
