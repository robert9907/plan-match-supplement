# Google Cloud Run image for Plan Match Supplement (HIPAA host, under the
# Google Cloud BAA). Vercel keeps building from main as before; this file
# is only used by Cloud Build.
FROM node:22-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY . .
# Browser-side settings baked in at build time (public values only).
ARG VITE_SUPABASE_ANON_KEY
ENV VITE_SUPABASE_ANON_KEY=$VITE_SUPABASE_ANON_KEY
RUN npm run build && npx tsc -p api/tsconfig.build.json

FROM node:22-slim AS deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund

FROM node:22-slim
WORKDIR /app
ENV NODE_ENV=production PORT=8080
COPY --from=deps /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
COPY --from=build /app/build ./build
COPY package.json vercel.json ./
COPY server ./server
USER node
EXPOSE 8080
CMD ["node", "server/server.mjs"]
