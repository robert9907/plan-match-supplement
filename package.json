{
  "name": "plan-match-supplement",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Plan Match Supplement — Medicare Supplement pre-qualification + application flow.",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/check-tcpa-mirror.mjs && node scripts/check-appointment-claim.mjs && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "npm run typecheck:app && npm run typecheck:api && npm run typecheck:qa",
    "typecheck:app": "tsc --noEmit",
    "typecheck:api": "tsc -p api/tsconfig.json",
    "typecheck:qa": "tsc -p qa/tsconfig.json",
    "test:compliance": "playwright test --config=qa/playwright.config.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.90.0",
    "chart.js": "^4.5.1",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.0",
    "@types/node": "^22.19.17",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vercel/node": "^5.7.13",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
